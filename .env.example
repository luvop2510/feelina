VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Server-only backup tooling (never prefix these with VITE_):
# DATABASE_URL=postgresql://...
# RESTORE_DATABASE_URL=postgresql://...disposable-target...

# Set true only after migrations are applied and cloud access rules verified.
VITE_SUPABASE_READY=false
